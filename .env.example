# Server-only settings. Provision an isolated local database before use.
DATABASE_URL=
ADMIN_DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:3021
# Shadow ingestion stores held jobs. dry-run queues only simulated delivery.
TERMINAL_INGEST_MODE=shadow
# CLI user provisioning reads these; no default account exists.
TERMINAL_ACCOUNT_EMAIL=
TERMINAL_ACCOUNT_PASSWORD=
# Optional monitor CLI only: one provisioned account UUID, no default.
TERMINAL_MONITOR_OWNER_ID=
