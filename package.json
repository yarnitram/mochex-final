{
  "name": "mochex-terminal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:domain": "tsc -p tsconfig.build.json",
    "build": "npm run build:domain && next build --webpack",
    "dev": "next dev --hostname 127.0.0.1 --port 3021",
    "monitor:core": "tsx scripts/monitor-core.ts",
    "start": "next start --hostname 127.0.0.1 --port 3021",
    "verify:workspace": "tsx scripts/verify-workspace.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "account:provision": "tsx scripts/provision-user.ts",
    "compare:sources": "tsx scripts/compare-sources.ts",
    "compare:chart": "tsx scripts/compare-chart.ts",
    "compare:mochbot": "tsx scripts/compare-mochbot.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "lightweight-charts": "5.2.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
